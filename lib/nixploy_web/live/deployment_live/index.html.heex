<Layouts.app flash={@flash} current_operator={@current_operator}>
  <div class="space-y-10">
    <header class="space-y-2">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">nixploy</p>
      <h1 class="text-4xl font-bold tracking-tight">Deployment control plane</h1>
      <p class="max-w-3xl text-base-content/70">
        Attach a Nix flake service to a Podman target and follow its durable deployment workflow.
        The current tracer delegates real deployments to the existing nixploy CLI.
      </p>
    </header>

    <section class="grid gap-4 md:grid-cols-3">
      <div class="stat rounded-box border border-base-300 bg-base-100 shadow-sm">
        <div class="stat-title">Repositories</div>
        <div class="stat-value text-3xl">{length(@repositories)}</div>
      </div>
      <div class="stat rounded-box border border-base-300 bg-base-100 shadow-sm">
        <div class="stat-title">Targets</div>
        <div class="stat-value text-3xl">{length(@targets)}</div>
      </div>
      <div class="stat rounded-box border border-base-300 bg-base-100 shadow-sm">
        <div class="stat-title">Services</div>
        <div class="stat-value text-3xl">{length(@services)}</div>
      </div>
    </section>

    <section class="grid gap-6 xl:grid-cols-3">
      <div class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body">
          <h2 class="card-title">1. Add repository</h2>
          <.form
            for={@repository_form}
            id="repository-form"
            phx-submit="save_repository"
            class="space-y-3"
          >
            <.input field={@repository_form[:name]} label="Name" placeholder="my-app" required />
            <.input
              field={@repository_form[:url]}
              type="url"
              label="Git URL"
              placeholder="https://github.com/example/my-app.git"
              required
            />
            <.input field={@repository_form[:default_ref]} label="Default ref" required />
            <.input
              field={@repository_form[:subdirectory]}
              label="Flake subdirectory"
              placeholder="."
              required
            />
            <.button class="w-full">Add repository</.button>
          </.form>
        </div>
      </div>

      <div class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body">
          <h2 class="card-title">2. Add target</h2>
          <.form for={@target_form} id="target-form" phx-submit="save_target" class="space-y-3">
            <.input field={@target_form[:name]} label="Name" placeholder="production" required />
            <.input
              field={@target_form[:host]}
              label="Host"
              placeholder="vps.example.com"
              required
            />
            <div class="grid grid-cols-2 gap-3">
              <.input field={@target_form[:ssh_user]} label="SSH user" required />
              <.input field={@target_form[:ssh_port]} type="number" label="SSH port" required />
            </div>
            <.button class="w-full">Add target</.button>
          </.form>
        </div>
      </div>

      <div class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body">
          <h2 class="card-title">3. Attach service</h2>
          <.form for={@service_form} id="service-form" phx-submit="save_service" class="space-y-3">
            <.input field={@service_form[:name]} label="Name" placeholder="web" required />
            <.input
              field={@service_form[:repository_id]}
              type="select"
              label="Repository"
              prompt="Select repository"
              options={@repository_options}
              required
            />
            <.input
              field={@service_form[:target_id]}
              type="select"
              label="Target"
              prompt="Select target"
              options={@target_options}
              required
            />
            <.input field={@service_form[:flake_output]} label="Flake output" required />
            <.input field={@service_form[:domain]} label="Domain" placeholder="app.example.com" />
            <.input field={@service_form[:health_path]} label="Health path" required />
            <.button class="w-full" disabled={@repositories == [] or @targets == []}>
              Attach service
            </.button>
          </.form>
        </div>
      </div>
    </section>

    <section id="configuration-inventory" class="space-y-4">
      <div>
        <h2 class="text-2xl font-bold">Configuration inventory</h2>
        <p class="text-sm text-base-content/60">
          Correct registrations here. Existing deployments retain their immutable snapshots.
        </p>
      </div>

      <div class="grid gap-4 xl:grid-cols-3">
        <details class="collapse-arrow collapse border border-base-300 bg-base-100">
          <summary class="collapse-title font-semibold">
            Repositories ({length(@repositories)})
          </summary>
          <div class="collapse-content space-y-4">
            <.form
              :for={repository <- @repositories}
              for={edit_repository_form(repository)}
              id={"edit-repository-#{repository.id}"}
              phx-submit="update_repository"
              class="space-y-2 border-t border-base-300 pt-4 first:border-0 first:pt-0"
            >
              <input type="hidden" name="_id" value={repository.id} />
              <.input
                id={"edit-repository-#{repository.id}-name"}
                field={edit_repository_form(repository)[:name]}
                label="Name"
                required
              />
              <.input
                id={"edit-repository-#{repository.id}-url"}
                field={edit_repository_form(repository)[:url]}
                label="Git URL"
                required
              />
              <div class="grid grid-cols-2 gap-2">
                <.input
                  id={"edit-repository-#{repository.id}-default-ref"}
                  field={edit_repository_form(repository)[:default_ref]}
                  label="Default ref"
                  required
                />
                <.input
                  id={"edit-repository-#{repository.id}-subdirectory"}
                  field={edit_repository_form(repository)[:subdirectory]}
                  label="Subdirectory"
                  required
                />
              </div>
              <.button class="btn-sm w-full">Save repository</.button>
            </.form>
          </div>
        </details>

        <details class="collapse-arrow collapse border border-base-300 bg-base-100">
          <summary class="collapse-title font-semibold">Targets ({length(@targets)})</summary>
          <div class="collapse-content space-y-4">
            <.form
              :for={target <- @targets}
              for={edit_target_form(target)}
              id={"edit-target-#{target.id}"}
              phx-submit="update_target"
              class="space-y-2 border-t border-base-300 pt-4 first:border-0 first:pt-0"
            >
              <input type="hidden" name="_id" value={target.id} />
              <.input
                id={"edit-target-#{target.id}-name"}
                field={edit_target_form(target)[:name]}
                label="Name"
                required
              />
              <.input
                id={"edit-target-#{target.id}-host"}
                field={edit_target_form(target)[:host]}
                label="Host"
                required
              />
              <div class="grid grid-cols-2 gap-2">
                <.input
                  id={"edit-target-#{target.id}-ssh-user"}
                  field={edit_target_form(target)[:ssh_user]}
                  label="SSH user"
                  required
                />
                <.input
                  id={"edit-target-#{target.id}-ssh-port"}
                  field={edit_target_form(target)[:ssh_port]}
                  type="number"
                  label="Port"
                  required
                />
              </div>
              <.button class="btn-sm w-full">Save target</.button>
            </.form>
          </div>
        </details>

        <details class="collapse-arrow collapse border border-base-300 bg-base-100">
          <summary class="collapse-title font-semibold">Services ({length(@services)})</summary>
          <div class="collapse-content space-y-4">
            <.form
              :for={service <- @services}
              for={edit_service_form(service)}
              id={"edit-service-#{service.id}"}
              phx-submit="update_service"
              class="space-y-2 border-t border-base-300 pt-4 first:border-0 first:pt-0"
            >
              <input type="hidden" name="_id" value={service.id} />
              <.input
                id={"edit-service-#{service.id}-name"}
                field={edit_service_form(service)[:name]}
                label="Name"
                required
              />
              <.input
                id={"edit-service-#{service.id}-repository"}
                field={edit_service_form(service)[:repository_id]}
                type="select"
                label="Repository"
                options={@repository_options}
                required
              />
              <.input
                id={"edit-service-#{service.id}-target"}
                field={edit_service_form(service)[:target_id]}
                type="select"
                label="Target"
                options={@target_options}
                required
              />
              <.input
                id={"edit-service-#{service.id}-flake-output"}
                field={edit_service_form(service)[:flake_output]}
                label="Flake output"
                required
              />
              <.input
                id={"edit-service-#{service.id}-domain"}
                field={edit_service_form(service)[:domain]}
                label="Domain"
              />
              <.input
                id={"edit-service-#{service.id}-health-path"}
                field={edit_service_form(service)[:health_path]}
                label="Health path"
                required
              />
              <.button class="btn-sm w-full">Save service</.button>
            </.form>
          </div>
        </details>
      </div>
    </section>

    <section class="card border border-base-300 bg-base-100 shadow-sm">
      <div class="card-body gap-6">
        <div>
          <h2 class="card-title">Queue deployment</h2>
          <p class="text-sm text-base-content/60">
            The worker pins the commit, validates the flake target, serializes the target mutation, and independently verifies the result.
          </p>
        </div>

        <.form
          for={@deployment_form}
          id="deployment-form"
          phx-submit="enqueue_deployment"
          phx-change="select_deployment_service"
          class="grid items-end gap-4 md:grid-cols-[2fr_1fr_auto]"
        >
          <.input
            field={@deployment_form[:service_id]}
            type="select"
            label="Service"
            prompt="Select service"
            options={@service_options}
            required
          />
          <.input field={@deployment_form[:requested_ref]} label="Git ref" required />
          <.button
            class="mb-2"
            disabled={@services == []}
            data-confirm="Deploy this immutable revision to the selected target?"
          >
            Deploy
          </.button>
        </.form>
      </div>
    </section>

    <section id="service-statuses" class="space-y-4">
      <div>
        <h2 class="text-2xl font-bold">Observed service status</h2>
        <p class="text-sm text-base-content/60">
          Status is read by a credentialed worker and persisted for the web role.
        </p>
      </div>

      <div :if={@services == []} class="alert">
        <.icon name="hero-information-circle" class="size-5" />
        <span>Attach a service before refreshing status.</span>
      </div>

      <article
        :for={service <- @services}
        id={"service-status-#{service.id}"}
        class="card border border-base-300 bg-base-100 shadow-sm"
      >
        <% observation = @observations_by_service[service.id] %>
        <% log_snapshot = @log_snapshots_by_service[service.id] %>
        <div class="card-body gap-5">
          <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-start">
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="card-title">{service.name}</h3>
                <span :if={observation} class={["badge", observation_class(observation.status)]}>
                  {observation.status}
                </span>
                <span :if={is_nil(observation)} class="badge badge-ghost">not observed</span>
              </div>
              <p class="text-sm text-base-content/60">
                {service.target.name}
                <span :if={service.domain}>{" · " <> service.domain}</span>
              </p>
            </div>
            <div class="flex flex-wrap gap-2">
              <.button
                id={"refresh-status-#{service.id}"}
                phx-click="refresh_service_status"
                phx-value-id={service.id}
                class="btn-sm"
                disabled={observation && observation.status == :pending}
              >
                Refresh status
              </.button>
              <.button
                id={"fetch-logs-#{service.id}"}
                phx-click="fetch_service_logs"
                phx-value-id={service.id}
                class="btn-outline btn-sm"
                disabled={log_snapshot && log_snapshot.status == :pending}
              >
                Fetch logs
              </.button>
            </div>
          </div>

          <div :if={is_nil(observation)} class="alert">
            <span>No worker observation has been requested.</span>
          </div>

          <div :if={observation && observation.failure} class="alert alert-error text-sm">
            <.icon name="hero-exclamation-circle" class="size-5" />
            <span>{observation.failure["message"] || observation.failure[:message]}</span>
          </div>

          <div :if={observation} class="grid gap-4 text-sm md:grid-cols-2 xl:grid-cols-4">
            <div>
              <span class="block text-xs uppercase text-base-content/50">Slots</span>
              <span class="font-medium">
                {observation.active_slot || "-"} active · {observation.inactive_slot || "-"} inactive
              </span>
            </div>
            <div>
              <span class="block text-xs uppercase text-base-content/50">Active container</span>
              <span class="font-mono text-xs">{observation.active_container || "-"}</span>
              <span class="block text-base-content/60">
                {observation.active_container_state || "-"}
              </span>
            </div>
            <div>
              <span class="block text-xs uppercase text-base-content/50">Inactive container</span>
              <span class="font-mono text-xs">{observation.inactive_container || "-"}</span>
              <span class="block text-base-content/60">
                {observation.inactive_container_state || "-"}
              </span>
            </div>
            <div>
              <span class="block text-xs uppercase text-base-content/50">Image</span>
              <span class="font-mono text-xs">{observation.image || "-"}</span>
            </div>
            <div>
              <span class="block text-xs uppercase text-base-content/50">Revision</span>
              <span class="font-mono">{short_commit(observation.git_commit)}</span>
              <span class="block text-base-content/60">
                {format_time(observation.deployed_at)}
              </span>
            </div>
            <div>
              <span class="block text-xs uppercase text-base-content/50">Caddy</span>
              <span class="font-mono text-xs">{observation.upstream || "-"}</span>
              <span class="block truncate text-base-content/60">
                {observation.caddy_route || "-"}
              </span>
            </div>
            <div>
              <span class="block text-xs uppercase text-base-content/50">Health</span>
              <span class={["badge", health_class(observation.health_status)]}>
                {observation.health_status || observation.health_error || "pending"}
              </span>
              <span class="block truncate text-base-content/60">
                {observation.health_url || "-"}
              </span>
            </div>
            <div>
              <span class="block text-xs uppercase text-base-content/50">Observed</span>
              <span>{format_time(observation.refreshed_at)}</span>
              <span class="block font-mono text-xs text-base-content/60">
                {observation.target_identity || "-"}
              </span>
            </div>
          </div>

          <section class="space-y-3 border-t border-base-300 pt-4">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div>
                <h4 class="font-semibold">Active container logs</h4>
                <p class="text-xs text-base-content/50">Latest bounded 200-entry snapshot.</p>
              </div>
              <span
                :if={log_snapshot}
                class={["badge", log_snapshot_class(log_snapshot.status)]}
              >
                {log_snapshot.status}
              </span>
            </div>

            <div :if={is_nil(log_snapshot)} class="rounded-box bg-base-200 p-4 text-sm">
              No log snapshot has been requested.
            </div>

            <div :if={log_snapshot && log_snapshot.failure} class="alert alert-error text-sm">
              <.icon name="hero-exclamation-circle" class="size-5" />
              <span>{log_snapshot.failure["message"] || log_snapshot.failure[:message]}</span>
            </div>

            <div :if={log_snapshot && log_snapshot.content} class="space-y-2">
              <div class="flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-base-content/60">
                <span>{log_snapshot.slot || "-"} · {log_snapshot.container_name || "-"}</span>
                <span>{log_snapshot.line_count || 0} lines</span>
                <span :if={log_snapshot.truncated} class="text-warning">output truncated</span>
                <span>{format_time(log_snapshot.fetched_at)}</span>
              </div>
              <pre
                id={"service-logs-#{service.id}"}
                class="max-h-96 overflow-auto rounded-box bg-neutral p-4 font-mono text-xs leading-relaxed text-neutral-content shadow-inner"
              ><code>{log_snapshot.content}</code></pre>
            </div>
          </section>
        </div>
      </article>
    </section>

    <section class="space-y-4">
      <div>
        <h2 class="text-2xl font-bold">Deployment history</h2>
        <p class="text-sm text-base-content/60">Newest deployments appear first.</p>
      </div>

      <div :if={@deployments == []} id="empty-deployments" class="alert">
        <.icon name="hero-information-circle" class="size-5" />
        <span>No deployments have been queued.</span>
      </div>

      <article
        :for={deployment <- @deployments}
        id={"deployment-#{deployment.id}"}
        class="card border border-base-300 bg-base-100 shadow-sm"
      >
        <div class="card-body gap-5">
          <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-start">
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="card-title">{deployment.service.name}</h3>
                <span class={["badge", state_class(deployment.state)]}>{deployment.state}</span>
                <span
                  :if={deployment.cancellation_requested_at}
                  class="badge badge-warning badge-outline"
                >
                  cancelling
                </span>
              </div>
              <p class="text-sm text-base-content/60">
                {deployment.service.repository.name}@{deployment.requested_ref} → {deployment.service.target.name}
                <span :if={deployment.service.domain}>{" · #{deployment.service.domain}"}</span>
              </p>
              <p class="mt-1 font-mono text-xs text-base-content/50">{deployment.id}</p>
              <p class="text-xs text-base-content/50">
                Requested by {if deployment.requested_by_operator,
                  do: deployment.requested_by_operator.email,
                  else: "system"}
              </p>
            </div>

            <div class="flex flex-wrap gap-2">
              <.button
                :if={terminal?(deployment) and deployment.resolved_commit}
                id={"retry-#{deployment.id}"}
                phx-click="retry_deployment"
                phx-value-id={deployment.id}
                data-confirm="Queue this exact commit and immutable configuration again?"
                class="btn-outline btn-sm"
              >
                Redeploy revision
              </.button>
              <.button
                :if={not terminal?(deployment) and is_nil(deployment.cancellation_requested_at)}
                id={"cancel-#{deployment.id}"}
                phx-click="cancel_deployment"
                phx-value-id={deployment.id}
                data-confirm="Cancel this deployment?"
                class="btn-warning btn-sm"
              >
                Cancel
              </.button>
            </div>
          </div>

          <div class="grid gap-3 text-sm sm:grid-cols-4">
            <div>
              <span class="block text-xs uppercase text-base-content/50">Current stage</span>
              <span class="font-medium">{deployment.current_stage}</span>
            </div>
            <div>
              <span class="block text-xs uppercase text-base-content/50">Revision</span>
              <span class="font-mono">{short_commit(deployment.resolved_commit)}</span>
            </div>
            <div>
              <span class="block text-xs uppercase text-base-content/50">Started</span>
              <span>{format_time(deployment.started_at)}</span>
            </div>
            <div>
              <span class="block text-xs uppercase text-base-content/50">Finished</span>
              <span>{format_time(deployment.finished_at)}</span>
            </div>
          </div>

          <div :if={deployment.output} class="space-y-2">
            <div class="flex flex-wrap gap-3 font-mono text-xs text-base-content/55">
              <span>{deployment.output.line_count} output lines retained as a bounded tail</span>
              <span :if={deployment.output.truncated} class="text-warning">
                earlier output truncated
              </span>
            </div>
            <pre
              id={"deployment-output-#{deployment.id}"}
              class="max-h-72 overflow-auto rounded-box bg-neutral p-4 font-mono text-xs leading-relaxed text-neutral-content shadow-inner"
            ><code>{deployment.output.content}</code></pre>
          </div>

          <div :if={deployment.failure} class="alert alert-error text-sm">
            <.icon name="hero-exclamation-circle" class="size-5" />
            <span>{deployment.failure["message"] || deployment.failure[:message]}</span>
          </div>

          <ol class="space-y-2 border-l border-base-300 pl-4">
            <li :for={event <- @events_by_deployment[deployment.id]} id={"event-#{event.id}"}>
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <span class="font-medium">{event.message}</span>
                <time class="font-mono text-xs text-base-content/50">
                  {format_time(event.inserted_at)}
                </time>
              </div>
              <span class="text-xs uppercase tracking-wide text-base-content/50">
                {event.stage}
              </span>
            </li>
          </ol>
        </div>
      </article>
    </section>

    <section id="audit-history" class="space-y-4">
      <div>
        <h2 class="text-2xl font-bold">Operator audit history</h2>
        <p class="text-sm text-base-content/60">Latest append-only control-plane actions.</p>
      </div>
      <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100">
        <table class="table table-sm">
          <thead>
            <tr>
              <th>Time</th>
              <th>Actor</th>
              <th>Action</th>
              <th>Resource</th>
              <th>Outcome</th>
            </tr>
          </thead>
          <tbody>
            <tr :for={event <- @audit_events} id={"audit-event-#{event.id}"}>
              <td class="whitespace-nowrap font-mono text-xs">
                {format_time(event.occurred_at)}
              </td>
              <td>{if event.operator, do: event.operator.email, else: "system"}</td>
              <td class="font-medium">{event.action}</td>
              <td class="font-mono text-xs">{event.resource_type}:{event.resource_id}</td>
              <td><span class="badge badge-ghost badge-sm">{event.outcome}</span></td>
            </tr>
            <tr :if={@audit_events == []}>
              <td colspan="5" class="text-center text-base-content/50">
                No audited actions yet.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Layouts.app>
