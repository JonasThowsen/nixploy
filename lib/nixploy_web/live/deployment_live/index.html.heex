<Layouts.app
  flash={@flash}
  current_operator={@current_operator}
  current_path={nav_path(@live_action)}
>
  <section :if={@live_action == :overview} id="operations-overview" class="np-page-stack">
    <header class="np-page-header">
      <div>
        <p class="np-kicker">Control plane</p>
        <h1 class="np-page-title">Overview</h1>
        <p class="np-page-description">Current runtime state and the shortest path to action.</p>
      </div>
      <.button
        id="refresh-local-inventory"
        phx-click="refresh_local_inventory"
        class="btn-outline btn-sm min-h-10 gap-2"
        disabled={@local_inventory_status == :loading}
      >
        <.icon
          name="hero-arrow-path"
          class={[@local_inventory_status == :loading && "animate-spin", "size-4"]}
        /> Refresh
      </.button>
    </header>

    <div id="local-host-inventory" class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
      <article class="np-stat">
        <p class="np-stat-label">Host</p>
        <p class="np-stat-value truncate">
          {if @local_inventory, do: @local_inventory.hostname, else: "—"}
        </p>
        <p class="np-stat-meta">
          runtime:{if @local_inventory, do: @local_inventory.runtime_user, else: "pending"}
        </p>
      </article>
      <article class="np-stat">
        <p class="np-stat-label">Podman</p>
        <div class="mt-2 flex items-center gap-2">
          <span class={[
            "size-2 rounded-full",
            @local_inventory_status == :available && "bg-success",
            @local_inventory_status == :loading && "animate-pulse bg-warning",
            @local_inventory_status == :failed && "bg-error"
          ]}>
          </span>
          <p class="np-stat-value">{@local_inventory_status}</p>
        </div>
        <p class="np-stat-meta">local · rootless</p>
      </article>
      <article class="np-stat">
        <p class="np-stat-label">Managed workloads</p>
        <p class="np-stat-number">{managed_workload_count(@local_inventory)}</p>
        <.link navigate={~p"/workloads"} class="np-stat-link">Inspect runtime →</.link>
      </article>
      <article class="np-stat">
        <p class="np-stat-label">Native operations</p>
        <p class="np-stat-number">{length(@native_deployments)}</p>
        <.link navigate={~p"/native-deployments"} class="np-stat-link">Open history →</.link>
      </article>
    </div>

    <div :if={@local_inventory_error} id="local-inventory-error" class="alert alert-error">
      <.icon name="hero-exclamation-triangle" class="size-5" />
      <span>{@local_inventory_error}</span>
    </div>

    <div class="grid min-w-0 gap-5 xl:grid-cols-[minmax(0,1.25fr)_minmax(18rem,0.75fr)]">
      <section class="np-panel min-w-0">
        <div class="np-panel-header">
          <div>
            <h2 class="np-panel-title">Runtime</h2>
            <p class="np-panel-description">Managed containers visible to the service user.</p>
          </div>
          <.link navigate={~p"/workloads"} class="btn btn-ghost btn-sm">All workloads</.link>
        </div>
        <div :if={@local_inventory_status == :loading} class="p-5 text-sm text-base-content/55">
          <span class="loading loading-spinner loading-xs mr-2"></span> Reading Podman…
        </div>
        <div
          :if={@local_inventory && managed_workload_count(@local_inventory) == 0}
          class="np-empty"
        >
          No managed workloads found.
        </div>
        <div :if={@local_inventory} class="divide-y divide-base-300">
          <article
            :for={workload <- Enum.filter(@local_inventory.workloads, & &1.managed?)}
            id={"local-workload-#{workload.id}"}
            class="grid min-w-0 gap-2 px-4 py-3 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center"
          >
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <span class={[
                  "size-2 shrink-0 rounded-full",
                  workload.state in ["running", "Running"] && "bg-success",
                  workload.state not in ["running", "Running"] && "bg-warning"
                ]}>
                </span>
                <h3 class="truncate font-semibold">{workload.project || workload.name}</h3>
                <span :if={workload.slot} class="badge badge-ghost badge-sm">
                  {workload.slot}
                </span>
              </div>
              <p class="mt-1 truncate font-mono text-xs text-base-content/45">{workload.image}</p>
            </div>
            <.link
              navigate={~p"/workloads"}
              class="btn btn-ghost btn-sm justify-self-start sm:justify-self-end"
            >
              Inspect
            </.link>
          </article>
        </div>
      </section>

      <aside class="np-panel">
        <div class="np-panel-header">
          <div>
            <h2 class="np-panel-title">Actions</h2>
            <p class="np-panel-description">Common operator workflows.</p>
          </div>
        </div>
        <nav class="divide-y divide-base-300" aria-label="Operator actions">
          <.link navigate={~p"/deployment-inputs"} class="np-action-row">
            <span class="np-action-icon"><.icon name="hero-plus" class="size-4" /></span>
            <span><strong>Stage input</strong><small>Verify an immutable Nix source</small></span>
            <.icon name="hero-chevron-right" class="ml-auto size-4" />
          </.link>
          <.link navigate={~p"/native-deployments"} class="np-action-row">
            <span class="np-action-icon"><.icon name="hero-command-line" class="size-4" /></span>
            <span>
              <strong>Follow operations</strong><small>Progress, failures, and rollback</small>
            </span>
            <.icon name="hero-chevron-right" class="ml-auto size-4" />
          </.link>
          <.link navigate={~p"/workloads"} class="np-action-row">
            <span class="np-action-icon">
              <.icon name="hero-magnifying-glass" class="size-4" />
            </span>
            <span>
              <strong>Investigate runtime</strong><small>Health, identity, and bounded logs</small>
            </span>
            <.icon name="hero-chevron-right" class="ml-auto size-4" />
          </.link>
        </nav>
      </aside>
    </div>
  </section>

  <section :if={@live_action == :workloads} id="workloads-page" class="np-page-stack">
    <header class="np-page-header">
      <div>
        <p class="np-kicker">Local runtime</p>
        <h1 class="np-page-title">Workloads</h1>
        <p class="np-page-description">Container identity, health, and bounded diagnostics.</p>
      </div>
      <.button
        id="refresh-local-inventory"
        phx-click="refresh_local_inventory"
        class="btn-outline btn-sm min-h-10 gap-2"
        disabled={@local_inventory_status == :loading}
      >
        <.icon
          name="hero-arrow-path"
          class={[@local_inventory_status == :loading && "animate-spin", "size-4"]}
        /> Refresh
      </.button>
    </header>

    <div :if={@local_inventory_error} id="local-inventory-error" class="alert alert-error">
      <.icon name="hero-exclamation-triangle" class="size-5" />
      <span>{@local_inventory_error}</span>
    </div>

    <div
      id="local-host-inventory"
      class="grid min-w-0 gap-5 xl:grid-cols-[minmax(18rem,0.72fr)_minmax(0,1.28fr)]"
    >
      <section class="np-panel min-w-0 self-start">
        <div class="np-panel-header">
          <div>
            <h2 class="np-panel-title">Inventory</h2>
            <p class="np-panel-description">
              {if @local_inventory,
                do: "#{length(@local_inventory.workloads)} containers",
                else: "Loading"}
            </p>
          </div>
        </div>
        <div :if={@local_inventory_status == :loading} class="p-5 text-sm text-base-content/55">
          <span class="loading loading-spinner loading-xs mr-2"></span> Reading Podman…
        </div>
        <div
          :if={@local_inventory && @local_inventory.workloads == []}
          id="empty-local-inventory"
          class="np-empty"
        >
          Podman is connected. No containers are visible.
        </div>
        <div :if={@local_inventory} class="divide-y divide-base-300">
          <article
            :for={workload <- @local_inventory.workloads}
            id={"local-workload-#{workload.id}"}
            class="p-3"
          >
            <button
              id={"inspect-workload-#{workload.id}"}
              type="button"
              phx-click="inspect_local_workload"
              phx-value-id={workload.id}
              class="flex min-h-12 w-full min-w-0 items-center gap-3 rounded-field px-2 text-left transition hover:bg-base-200"
            >
              <span class={[
                "size-2 shrink-0 rounded-full",
                workload.state in ["running", "Running"] && "bg-success",
                workload.state not in ["running", "Running"] && "bg-warning"
              ]}>
              </span>
              <span class="min-w-0 flex-1">
                <span class="flex items-center gap-2">
                  <strong class="truncate text-sm">{workload.project || workload.name}</strong>
                  <span :if={workload.slot} class="badge badge-ghost badge-xs">
                    {workload.slot}
                  </span>
                </span>
                <span class="block truncate font-mono text-[0.68rem] text-base-content/45">
                  {workload.name}
                </span>
              </span>
              <span class={[
                "badge badge-sm",
                workload.managed? && "badge-primary badge-outline",
                !workload.managed? && "badge-ghost"
              ]}>
                {if workload.managed?, do: "managed", else: "external"}
              </span>
            </button>
          </article>
        </div>
      </section>

      <section id="local-workload-details" class="np-panel min-w-0 overflow-hidden">
        <div
          :if={is_nil(@selected_workload)}
          class="grid min-h-72 place-items-center p-8 text-center"
        >
          <div class="max-w-sm">
            <.icon name="hero-cube-transparent" class="mx-auto size-9 text-base-content/25" />
            <h2 class="mt-3 font-semibold">Select a workload</h2>
            <p class="mt-1 text-sm text-base-content/50">
              Runtime evidence stays focused here instead of expanding the dashboard.
            </p>
          </div>
        </div>

        <div :if={@selected_workload}>
          <header class="np-panel-header">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <h2 class="truncate text-lg font-semibold">
                  {@selected_workload.project || @selected_workload.name}
                </h2>
                <span class={[
                  "badge badge-sm",
                  @selected_workload.managed? && "badge-primary badge-outline",
                  !@selected_workload.managed? && "badge-ghost"
                ]}>
                  {if @selected_workload.managed?, do: "nixploy managed", else: "unmanaged"}
                </span>
              </div>
              <p class="mt-1 break-all font-mono text-xs text-base-content/45">
                {@selected_workload.name} · {@selected_workload.id}
              </p>
            </div>
            <div class="flex flex-wrap gap-2">
              <.button
                :if={@selected_workload.managed?}
                id="probe-local-health"
                phx-click="probe_local_health"
                class="btn-primary btn-sm"
                disabled={@local_health_status == :loading}
              >
                Probe health
              </.button>
              <.button
                id="refresh-local-workload"
                phx-click="refresh_local_workload"
                class="btn-ghost btn-sm"
              >
                Refresh
              </.button>
              <.button
                id="close-local-workload"
                phx-click="close_local_workload"
                class="btn-ghost btn-sm"
              >
                Close
              </.button>
            </div>
          </header>

          <div class="space-y-5 p-4 sm:p-5">
            <div :if={@workload_details_status == :loading} class="text-sm text-base-content/55">
              <span class="loading loading-spinner loading-xs mr-2"></span> Inspecting runtime…
            </div>
            <div
              :if={@workload_details_error}
              id="local-workload-details-error"
              class="alert alert-error text-sm"
            >
              {@workload_details_error}
            </div>

            <div :if={details = @workload_details} class="space-y-5">
              <dl class="grid gap-px overflow-hidden rounded-box bg-base-300 sm:grid-cols-2 lg:grid-cols-4">
                <div class="np-data-cell">
                  <dt>State</dt>
                  <dd>{details.state || "unknown"} · {details.status || "—"}</dd>
                </div>
                <div class="np-data-cell">
                  <dt>Health</dt>
                  <dd>{details.health || "not reported"}</dd>
                </div>
                <div class="np-data-cell">
                  <dt>Slot</dt>
                  <dd>{details.slot || "—"}</dd>
                </div>
                <div class="np-data-cell">
                  <dt>Revision</dt>
                  <dd class="font-mono">{short_commit(details.revision)}</dd>
                </div>
                <div class="np-data-cell sm:col-span-2">
                  <dt>Image</dt>
                  <dd class="break-all font-mono text-xs">
                    {details.image}<br />{details.image_id}
                  </dd>
                </div>
                <div class="np-data-cell sm:col-span-2">
                  <dt>Published ports</dt>
                  <dd>
                    {Enum.join(details.published_ports || [], ", ")
                    |> case do
                      "" -> "none"
                      ports -> ports
                    end}
                  </dd>
                </div>
              </dl>

              <section :if={@selected_workload.managed?} class="space-y-3">
                <div class="flex items-center justify-between gap-3">
                  <h3 class="text-sm font-semibold">Health observation</h3>
                  <span
                    :if={@local_health_status != :idle}
                    class={["badge badge-sm", local_health_class(@local_health_status)]}
                  >
                    {@local_health_status}
                  </span>
                </div>
                <div
                  :if={@local_health_error}
                  id="local-health-error"
                  class="alert alert-error text-sm"
                >
                  {@local_health_error}
                </div>
                <div
                  :if={health = @local_health_observation}
                  id="local-health-observation"
                  class="grid gap-3 rounded-box bg-base-200 p-4 text-sm sm:grid-cols-2"
                >
                  <p>
                    <span class="np-field-label">Result</span>{health.status} {if health.status_code,
                      do: "· HTTP #{health.status_code}"}
                  </p>
                  <p><span class="np-field-label">Container</span>{health.container_state}</p>
                  <p class="break-all font-mono text-xs sm:col-span-2">
                    <span class="np-field-label">Endpoint</span>{health.endpoint}
                  </p>
                  <p class="sm:col-span-2">
                    <span class="np-field-label">Observed</span>{format_time(health.observed_at)}
                  </p>
                </div>
              </section>

              <section class="space-y-2">
                <div class="flex items-end justify-between gap-3">
                  <div>
                    <h3 class="text-sm font-semibold">Recent logs</h3>
                    <p class="text-xs text-base-content/45">At most 200 lines / 64 KiB</p>
                  </div>
                  <span class="font-mono text-xs text-base-content/45">
                    {details.log_line_count || 0} lines
                  </span>
                </div>
                <div
                  :if={details.logs_error}
                  id="local-workload-logs-error"
                  class="alert alert-error text-sm"
                >
                  {workload_logs_error(details.logs_error)}
                </div>
                <pre
                  :if={is_binary(details.logs)}
                  id="local-workload-logs"
                  class="max-h-96 overflow-auto rounded-box bg-neutral p-4 font-mono text-xs leading-relaxed text-neutral-content"
                ><code>{details.logs}</code></pre>
              </section>
            </div>
          </div>
        </div>
      </section>
    </div>
  </section>

  <section :if={@live_action == :inputs} id="inputs-page" class="np-page-stack">
    <header class="np-page-header">
      <div>
        <p class="np-kicker">Immutable handoff</p>
        <h1 class="np-page-title">Deployment inputs</h1>
        <p class="np-page-description">
          Inspect, verify, and stage flake-owned intent. Staging does not mutate runtime.
        </p>
      </div>
    </header>

    <section id="immutable-input-staging" class="np-panel overflow-hidden">
      <div class="np-panel-header">
        <div>
          <h2 class="np-panel-title">Stage a local store source</h2>
          <p class="np-panel-description">Nix path verification and schema evaluation only.</p>
        </div>
        <span class="badge badge-outline badge-sm">read-only</span>
      </div>
      <div class="space-y-4 p-4 sm:p-5">
        <.form
          for={@local_store_form}
          id="local-store-inspect-form"
          phx-submit="inspect_local_store"
          class="grid min-w-0 gap-3 md:grid-cols-[minmax(0,1fr)_auto] md:items-end"
        >
          <.input
            field={@local_store_form[:store_path]}
            label="Immutable Nix store source"
            placeholder="/nix/store/…-source"
            autocomplete="off"
            required
          />
          <.button class="mb-2 min-h-11 gap-2">
            <.icon name="hero-magnifying-glass" class="size-4" /> Inspect
          </.button>
        </.form>
        <div :if={@local_store_error} id="local-store-error" class="alert alert-error items-start">
          <.icon name="hero-exclamation-triangle" class="size-5 shrink-0" />
          <span class="break-words">
            {@local_store_error}
          </span>
        </div>
      </div>

      <div
        :if={source = @local_store_candidate}
        id="local-store-candidate"
        class="border-t border-base-300 bg-success/5 p-4 sm:p-5"
      >
        <div class="grid min-w-0 gap-5 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
          <div class="min-w-0 space-y-4">
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="text-lg font-semibold">{source.project}</h3>
                <span class="badge badge-success badge-outline badge-sm">verified</span>
              </div>
              <p class="mt-1 break-all font-mono text-xs text-base-content/50">
                {source.store_path}
              </p>
              <p class="mt-2 break-all font-mono text-xs">{source.nar_hash}</p>
            </div>
            <.form
              for={@local_store_stage_form}
              id="local-store-stage-form"
              phx-change="select_local_store_target"
              phx-submit="stage_local_store"
              class="space-y-3"
            >
              <.input
                field={@local_store_stage_form[:selected_target]}
                type="select"
                label="Target from flake"
                prompt="Select target"
                options={local_store_target_options(source)}
                required
              />
              <.button class="min-h-11 w-full" disabled={is_nil(@local_store_selected_target)}>
                Stage verified input
              </.button>
            </.form>
          </div>
          <% target = selected_local_store_target(source, @local_store_selected_target) %>
          <dl
            :if={target}
            id="local-store-target-preview"
            class="grid min-w-0 gap-px overflow-hidden rounded-box bg-base-300 sm:grid-cols-2"
          >
            <div class="np-data-cell sm:col-span-2">
              <dt>Image output</dt>
              <dd class="break-all font-mono text-xs">{target["image_output"]}</dd>
            </div>
            <div class="np-data-cell">
              <dt>Blue</dt>
              <dd class="font-mono">{target["slots"]["blue"]}</dd>
            </div>
            <div class="np-data-cell">
              <dt>Green</dt>
              <dd class="font-mono">{target["slots"]["green"]}</dd>
            </div>
            <div class="np-data-cell sm:col-span-2">
              <dt>Domain</dt>
              <dd class="break-all font-mono text-xs">{target["domain"]}</dd>
            </div>
            <div class="np-data-cell sm:col-span-2">
              <dt>Health path</dt>
              <dd class="break-all font-mono text-xs">{target["health_path"]}</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section id="deployment-input-history" class="np-panel overflow-hidden">
      <div class="np-panel-header">
        <div>
          <h2 class="np-panel-title">Staged history</h2>
          <p class="np-panel-description">Immutable evidence and actor attribution.</p>
        </div>
        <span class="font-mono text-xs text-base-content/45">
          {length(@deployment_inputs)} records
        </span>
      </div>
      <div :if={@deployment_inputs == []} id="empty-deployment-inputs" class="np-empty">
        No immutable inputs staged.
      </div>
      <div class="divide-y divide-base-300">
        <article
          :for={input <- @deployment_inputs}
          id={"deployment-input-#{input.id}"}
          class="grid min-w-0 gap-3 p-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center"
        >
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="truncate font-semibold">
                {input.derived_snapshot["project"] || input.selected_target || "Failed input"}
              </h3>
              <span class={["badge badge-sm", input_state_class(input.state)]}>
                {input.state}
              </span>
              <span :if={input.selected_target} class="badge badge-ghost badge-sm">
                {input.selected_target}
              </span>
            </div>
            <p class="mt-1 truncate font-mono text-xs text-base-content/45">{input.store_path}</p>
            <p :if={input.failure} class="mt-1 break-words text-sm text-error">
              {input.failure["message"]}
            </p>
            <p class="mt-1 text-xs text-base-content/45">
              {format_time(input.inserted_at)} · {if input.requested_by_operator,
                do: input.requested_by_operator.email,
                else: "system"}
            </p>
          </div>
          <.link
            navigate={~p"/deployment-inputs/#{input.id}"}
            class="btn btn-outline btn-sm min-h-10"
          >
            Open
          </.link>
        </article>
      </div>
    </section>
  </section>

  <section :if={@live_action == :operations} id="native-operations-page" class="np-page-stack">
    <header class="np-page-header">
      <div>
        <p class="np-kicker">Execution ledger</p>
        <h1 class="np-page-title">Native operations</h1>
        <p class="np-page-description">
          Deployments and rollbacks with durable stage and failure evidence.
        </p>
      </div>
      <.link navigate={~p"/deployment-inputs"} class="btn btn-primary btn-sm min-h-10 gap-2">
        <.icon name="hero-plus" class="size-4" /> New deployment
      </.link>
    </header>

    <section class="np-panel overflow-hidden">
      <div class="np-panel-header">
        <div>
          <h2 class="np-panel-title">History</h2>
          <p class="np-panel-description">Newest request first.</p>
        </div>
        <span class="font-mono text-xs text-base-content/45">
          {length(@native_deployments)} operations
        </span>
      </div>
      <div :if={@native_deployments == []} id="empty-native-deployments" class="np-empty">
        No native operation has been queued.
      </div>
      <div class="divide-y divide-base-300">
        <article
          :for={deployment <- @native_deployments}
          id={"native-deployment-#{deployment.id}"}
          class="grid min-w-0 gap-4 p-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center"
        >
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <span class={[
                "grid size-8 place-items-center rounded-field",
                deployment.operation_kind == :rollback && "bg-warning/15 text-warning",
                deployment.operation_kind != :rollback && "bg-primary/10 text-primary"
              ]}>
                <.icon
                  name={
                    if deployment.operation_kind == :rollback,
                      do: "hero-arrow-uturn-left",
                      else: "hero-rocket-launch"
                  }
                  class="size-4"
                />
              </span>
              <h3 class="truncate font-semibold">{deployment.project}</h3>
              <span class="text-sm text-base-content/40">→</span><span class="text-sm">{deployment.target}</span><span class={[
                "badge badge-sm",
                state_class(deployment.state)
              ]}>{deployment.state}</span>
            </div>
            <p class="mt-2 truncate font-mono text-xs text-base-content/45">{deployment.id}</p>
            <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-base-content/50">
              <span>{deployment.operation_kind}</span><span>{deployment.current_stage}</span><span>{deployment.selected_slot || "slot pending"}</span><span>{format_time(deployment.inserted_at)}</span>
            </div>
            <p :if={deployment.failure} class="mt-2 break-words text-sm text-error">
              {deployment.failure["message"]}
            </p>
          </div>
          <.link
            navigate={~p"/native-deployments/#{deployment.id}"}
            class="btn btn-outline btn-sm min-h-10"
          >
            Open evidence
          </.link>
        </article>
      </div>
    </section>
  </section>

  <div :if={@live_action == :compatibility} class="space-y-10">
    <header class="grid gap-6 border-b border-base-300 pb-8 lg:grid-cols-[1fr_auto] lg:items-end">
      <div class="space-y-3">
        <p class="font-mono text-xs font-bold uppercase tracking-[0.28em] text-primary">
          Local control plane
        </p>
        <h1 class="max-w-4xl text-4xl font-bold tracking-[-0.04em] sm:text-6xl">
          What is running on this host?
        </h1>
        <p class="max-w-3xl text-base leading-relaxed text-base-content/65 sm:text-lg">
          Podman is observed directly as the service user. Nix flakes describe future deployments;
          the host inventory below describes reality now.
        </p>
      </div>
      <.button
        id="refresh-local-inventory"
        phx-click="refresh_local_inventory"
        class="btn-outline gap-2"
        disabled={@local_inventory_status == :loading}
      >
        <.icon
          name="hero-arrow-path"
          class={[
            "size-4",
            @local_inventory_status == :loading && "animate-spin"
          ]}
        />
        {if @local_inventory_status == :loading, do: "Observing", else: "Refresh host"}
      </.button>
    </header>

    <section id="local-host-inventory" class="space-y-5">
      <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
        <div class="rounded-box border border-base-300 bg-base-100 p-5 shadow-sm">
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-base-content/45">
            Host
          </p>
          <p class="mt-3 truncate text-xl font-bold">
            {if @local_inventory, do: @local_inventory.hostname, else: "Detecting…"}
          </p>
          <p class="mt-1 font-mono text-xs text-base-content/50">
            user:{if @local_inventory, do: @local_inventory.runtime_user, else: "-"}
          </p>
        </div>
        <div class="rounded-box border border-base-300 bg-base-100 p-5 shadow-sm">
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-base-content/45">
            Podman
          </p>
          <div class="mt-3 flex items-center gap-2">
            <span class={[
              "size-2 rounded-full",
              @local_inventory_status == :available &&
                "bg-success shadow-[0_0_0.8rem] shadow-success/60",
              @local_inventory_status == :loading && "animate-pulse bg-warning",
              @local_inventory_status == :failed && "bg-error"
            ]}>
            </span>
            <p class="text-xl font-bold">{@local_inventory_status}</p>
          </div>
          <p class="mt-1 text-xs text-base-content/50">local runtime · no SSH</p>
        </div>
        <div class="rounded-box border border-base-300 bg-base-100 p-5 shadow-sm">
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-base-content/45">
            Workloads
          </p>
          <p class="mt-3 text-3xl font-bold tabular-nums">
            {if @local_inventory, do: length(@local_inventory.workloads), else: "—"}
          </p>
          <p class="mt-1 text-xs text-base-content/50">containers visible to this user</p>
        </div>
        <div class="rounded-box border border-base-300 bg-base-100 p-5 shadow-sm">
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-base-content/45">
            Managed
          </p>
          <p class="mt-3 text-3xl font-bold tabular-nums">
            {managed_workload_count(@local_inventory)}
          </p>
          <p class="mt-1 text-xs text-base-content/50">identified by nixploy labels</p>
        </div>
      </div>

      <div
        :if={@local_inventory_status == :loading}
        class="alert border border-base-300 bg-base-100"
      >
        <span class="loading loading-spinner loading-sm"></span>
        <span>Reading the local Podman inventory…</span>
      </div>

      <div :if={@local_inventory_error} class="alert alert-error" id="local-inventory-error">
        <.icon name="hero-exclamation-triangle" class="size-5" />
        <div>
          <p class="font-semibold">Local Podman inventory is unavailable</p>
          <p class="text-sm">{@local_inventory_error}</p>
        </div>
      </div>

      <div
        :if={@local_inventory && @local_inventory.workloads == []}
        id="empty-local-inventory"
        class="grid min-h-56 place-items-center rounded-box border border-dashed border-base-300 bg-base-100/60 p-8 text-center"
      >
        <div class="max-w-md space-y-3">
          <div class="mx-auto grid size-12 place-items-center rounded-full border border-base-300 bg-base-200">
            <.icon name="hero-cube-transparent" class="size-6 text-base-content/55" />
          </div>
          <h2 class="text-xl font-bold">Podman is connected. The host is quiet.</h2>
          <p class="text-sm leading-relaxed text-base-content/55">
            Containers started by this Podman user will appear automatically. No target registration is required.
          </p>
        </div>
      </div>

      <div
        :if={@local_inventory && @local_inventory.workloads != []}
        class="overflow-hidden rounded-box border border-base-300 bg-base-100 shadow-sm"
      >
        <div class="flex flex-col gap-2 border-b border-base-300 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h2 class="text-xl font-bold">Local workloads</h2>
            <p class="text-sm text-base-content/50">
              Managed and unmanaged containers are shown together.
            </p>
          </div>
          <p class="font-mono text-xs text-base-content/45">
            observed {format_time(@local_inventory.observed_at)}
          </p>
        </div>

        <div class="divide-y divide-base-300">
          <article
            :for={workload <- @local_inventory.workloads}
            id={"local-workload-#{workload.id}"}
            class="grid gap-4 px-5 py-5 transition-colors hover:bg-base-200/50 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)_auto] lg:items-center"
          >
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="truncate text-lg font-bold">{workload.project || workload.name}</h3>
                <span :if={workload.managed?} class="badge badge-primary badge-outline badge-sm">
                  nixploy
                </span>
                <span :if={not workload.managed?} class="badge badge-ghost badge-sm">
                  unmanaged
                </span>
                <span class={["badge badge-sm", workload_state_class(workload.state)]}>
                  {workload.state || "unknown"}
                </span>
                <span :if={workload.slot} class="badge badge-ghost badge-sm">
                  {workload.slot}
                </span>
              </div>
              <p class="mt-1 truncate font-mono text-xs text-base-content/45">{workload.name}</p>
            </div>

            <div class="min-w-0 space-y-1">
              <p class="truncate font-mono text-xs">{workload.image || "unknown image"}</p>
              <p class="truncate text-xs text-base-content/50">
                {workload.status || "No runtime status"}
                <span :if={workload.pod not in [nil, ""]}>{" · pod " <> workload.pod}</span>
              </p>
            </div>

            <div class="min-w-36 text-left lg:text-right">
              <a
                :if={repository_link?(workload.repository)}
                href={workload.repository}
                target="_blank"
                rel="noreferrer"
                class="link link-hover block truncate text-sm font-semibold"
              >
                {workload.repository}
              </a>
              <p
                :if={workload.repository && not repository_link?(workload.repository)}
                class="truncate font-mono text-xs text-base-content/55"
              >
                {workload.repository}
              </p>
              <p :if={is_nil(workload.repository)} class="text-sm text-base-content/40">
                repository unknown
              </p>
              <p class="mt-1 font-mono text-xs text-base-content/50">
                {short_commit(workload.revision)}
              </p>
              <.button
                id={"inspect-workload-#{workload.id}"}
                phx-click="inspect_local_workload"
                phx-value-id={workload.id}
                class="btn-outline btn-sm mt-3"
              >
                Inspect
              </.button>
            </div>
          </article>
        </div>
      </div>

      <section
        :if={@selected_workload}
        id="local-workload-details"
        class="overflow-hidden rounded-box border border-base-300 bg-base-100 shadow-sm"
      >
        <header class="flex flex-col gap-4 border-b border-base-300 px-5 py-4 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h2 class="text-2xl font-bold">
                {@selected_workload.project || @selected_workload.name}
              </h2>
              <span class={[
                "badge badge-sm",
                @selected_workload.managed? && "badge-primary badge-outline",
                not @selected_workload.managed? && "badge-ghost"
              ]}>
                {if @selected_workload.managed?, do: "nixploy managed", else: "unmanaged"}
              </span>
            </div>
            <p class="mt-1 font-mono text-xs text-base-content/50">
              {@selected_workload.name} · {@selected_workload.id}
            </p>
          </div>
          <div class="flex flex-wrap gap-2">
            <.button
              :if={@selected_workload.managed?}
              id="probe-local-health"
              phx-click="probe_local_health"
              class="btn-primary btn-sm"
              disabled={@local_health_status == :loading}
            >
              <span
                :if={@local_health_status == :loading}
                class="loading loading-spinner loading-xs"
              >
              </span>
              Probe health
            </.button>
            <.button
              id="refresh-local-workload"
              phx-click="refresh_local_workload"
              class="btn-outline btn-sm"
              disabled={@workload_details_status == :loading}
            >
              <.icon
                name="hero-arrow-path"
                class={[
                  "size-4",
                  @workload_details_status == :loading && "animate-spin"
                ]}
              /> Refresh
            </.button>
            <.button
              id="close-local-workload"
              phx-click="close_local_workload"
              class="btn-ghost btn-sm"
            >
              Close
            </.button>
          </div>
        </header>

        <div class="space-y-5 p-5">
          <div :if={@workload_details_status == :loading} class="alert">
            <span class="loading loading-spinner loading-sm"></span>
            <span>Inspecting runtime metadata and recent logs…</span>
          </div>

          <div
            :if={@workload_details_error}
            id="local-workload-details-error"
            class="alert alert-error"
          >
            <.icon name="hero-exclamation-triangle" class="size-5" />
            <div>
              <p class="font-semibold">Workload inspection failed</p>
              <p class="text-sm">{@workload_details_error}</p>
            </div>
          </div>

          <div :if={details = @workload_details} class="space-y-6">
            <div class="grid gap-4 text-sm sm:grid-cols-2 xl:grid-cols-4">
              <div>
                <span class="block text-xs uppercase text-base-content/50">Container</span>
                <span class="font-mono text-xs">{details.id}</span>
              </div>
              <div>
                <span class="block text-xs uppercase text-base-content/50">Runtime state</span>
                <span class={["badge badge-sm", workload_state_class(details.state)]}>
                  {details.state || "unknown"}
                </span>
                <span class="ml-2 text-base-content/60">{details.status || "-"}</span>
              </div>
              <div>
                <span class="block text-xs uppercase text-base-content/50">Runtime health</span>
                <span class="font-medium">{details.health || "not reported"}</span>
              </div>
              <div>
                <span class="block text-xs uppercase text-base-content/50">Observed</span>
                <span>{format_time(details.observed_at)}</span>
              </div>
              <div class="sm:col-span-2">
                <span class="block text-xs uppercase text-base-content/50">Image</span>
                <span class="block font-mono text-xs">{details.image || "unknown"}</span>
                <span class="block break-all font-mono text-xs text-base-content/50">
                  {details.image_id || "image ID unavailable"}
                </span>
              </div>
              <div>
                <span class="block text-xs uppercase text-base-content/50">Created</span>
                <span>{format_time(details.created_at)}</span>
              </div>
              <div>
                <span class="block text-xs uppercase text-base-content/50">Started</span>
                <span>{format_time(details.started_at)}</span>
              </div>
              <div>
                <span class="block text-xs uppercase text-base-content/50">Project / target</span>
                <span>{details.project || "-"} / {details.target || "-"}</span>
              </div>
              <div>
                <span class="block text-xs uppercase text-base-content/50">Slot</span>
                <span>{details.slot || "-"}</span>
              </div>
              <div>
                <span class="block text-xs uppercase text-base-content/50">Revision</span>
                <span class="font-mono">{short_commit(details.revision)}</span>
              </div>
              <div>
                <span class="block text-xs uppercase text-base-content/50">Deployed</span>
                <span>{details.deployed_at || "-"}</span>
              </div>
              <div class="sm:col-span-2 xl:col-span-4">
                <span class="block text-xs uppercase text-base-content/50">Source</span>
                <a
                  :if={repository_link?(details.repository)}
                  href={details.repository}
                  target="_blank"
                  rel="noreferrer"
                  class="link link-hover break-all font-mono text-xs"
                >
                  {details.repository}
                </a>
                <span
                  :if={not repository_link?(details.repository)}
                  class="break-all font-mono text-xs"
                >
                  {details.repository || "not labeled"}
                </span>
              </div>
            </div>

            <div>
              <h3 class="font-semibold">Published ports</h3>
              <p :if={details.published_ports == []} class="mt-1 text-sm text-base-content/50">
                No published ports reported.
              </p>
              <div :if={details.published_ports != []} class="mt-2 flex flex-wrap gap-2">
                <span :for={port <- details.published_ports} class="badge badge-ghost font-mono">
                  {port}
                </span>
              </div>
            </div>

            <section
              :if={@selected_workload.managed?}
              class="space-y-3 border-t border-base-300 pt-5"
            >
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div>
                  <h3 class="font-semibold">Local HTTP health probe</h3>
                  <p class="text-xs text-base-content/50">
                    Loopback only · fixed /health and /ready candidates · 7-second command timeout
                  </p>
                </div>
                <span
                  :if={@local_health_status != :idle}
                  class={["badge", local_health_class(@local_health_status)]}
                >
                  {@local_health_status}
                </span>
              </div>

              <div :if={@local_health_status == :loading} class="alert">
                <span class="loading loading-spinner loading-sm"></span>
                <span>Observing container state and probing localhost…</span>
              </div>

              <div
                :if={@local_health_error}
                id="local-health-error"
                class="alert alert-error text-sm"
              >
                <.icon name="hero-exclamation-triangle" class="size-5" />
                <span>{@local_health_error}</span>
              </div>

              <div
                :if={health = @local_health_observation}
                id="local-health-observation"
                class="grid gap-4 rounded-box bg-base-200/60 p-4 text-sm sm:grid-cols-2 xl:grid-cols-4"
              >
                <div>
                  <span class="block text-xs uppercase text-base-content/50">
                    Container state
                  </span>
                  <span>{health.container_state || "unknown"}</span>
                </div>
                <div>
                  <span class="block text-xs uppercase text-base-content/50">Result</span>
                  <span class={["badge badge-sm", local_health_class(health.status)]}>
                    {health.status}
                  </span>
                  <span :if={health.status_code} class="ml-2 font-mono">
                    HTTP {health.status_code}
                  </span>
                </div>
                <div>
                  <span class="block text-xs uppercase text-base-content/50">Endpoint</span>
                  <span class="break-all font-mono text-xs">{health.endpoint || "-"}</span>
                </div>
                <div>
                  <span class="block text-xs uppercase text-base-content/50">Observed</span>
                  <span>{format_time(health.observed_at)}</span>
                </div>
                <div :if={health.failure} class="sm:col-span-2 xl:col-span-4 text-error">
                  <span class="block text-xs uppercase">Failure reason</span>
                  <span>{health.failure}</span>
                </div>
              </div>
            </section>

            <section class="space-y-3 border-t border-base-300 pt-5">
              <div class="flex flex-wrap items-end justify-between gap-2">
                <div>
                  <h3 class="font-semibold">Recent container logs</h3>
                  <p class="text-xs text-base-content/50">
                    Ephemeral snapshot · at most 200 lines and 64 KiB
                  </p>
                </div>
                <p
                  :if={not is_nil(details.log_line_count)}
                  class="font-mono text-xs text-base-content/55"
                >
                  {details.log_line_count} lines
                  <span :if={details.logs_truncated?} class="text-warning">
                    · bytes truncated
                  </span>
                </p>
              </div>

              <div
                :if={details.logs_error}
                id="local-workload-logs-error"
                class="alert alert-error text-sm"
              >
                <.icon name="hero-exclamation-circle" class="size-5" />
                <span>{workload_logs_error(details.logs_error)}</span>
              </div>

              <pre
                :if={is_binary(details.logs)}
                id="local-workload-logs"
                class="max-h-96 overflow-auto rounded-box bg-neutral p-4 font-mono text-xs leading-relaxed text-neutral-content shadow-inner"
              ><code>{details.logs}</code></pre>
            </section>
          </div>
        </div>
      </section>

      <div class="grid gap-4 lg:grid-cols-[1fr_auto] lg:items-center rounded-box border border-base-300 bg-base-200/45 px-5 py-4">
        <div>
          <p class="font-semibold">Repository context is deliberately deferred.</p>
          <p class="text-sm text-base-content/55">
            Local runtime state stays useful without repository onboarding or database forms. Project flakes remain the configuration source.
          </p>
        </div>
        <span class="badge badge-ghost">local first</span>
      </div>
    </section>

    <section id="immutable-input-staging" class="space-y-5 border-t border-base-300 pt-8">
      <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.7fr)] lg:items-end">
        <div class="space-y-2">
          <p class="font-mono text-xs font-bold uppercase tracking-[0.24em] text-primary">
            Native path · slice 1.1
          </p>
          <h2 class="text-3xl font-bold tracking-[-0.035em] sm:text-4xl">
            Stage an immutable source
          </h2>
          <p class="max-w-2xl text-sm leading-relaxed text-base-content/60 sm:text-base">
            Verify one existing local Nix store flake, derive its schema v0.2 targets, and preserve the exact input as operation evidence. No runtime mutation occurs.
          </p>
        </div>
        <div class="rounded-box border border-primary/25 bg-primary/5 p-4 text-sm">
          <p class="font-semibold text-primary">Read-only boundary</p>
          <p class="mt-1 text-base-content/60">
            Nix path verification and evaluation only. Podman and Caddy are not invoked.
          </p>
        </div>
      </div>

      <%!-- TODO(tracer): Replace local path entry with authenticated operator-side
      Nix closure transport before sources originating on another machine are accepted. --%>
      <.form
        for={@local_store_form}
        id="local-store-inspect-form"
        phx-submit="inspect_local_store"
        class="grid min-w-0 gap-3 rounded-box border border-base-300 bg-base-100 p-5 shadow-sm md:grid-cols-[minmax(0,1fr)_auto] md:items-end"
      >
        <.input
          field={@local_store_form[:store_path]}
          label="Immutable Nix store source"
          placeholder="/nix/store/…-source"
          autocomplete="off"
          required
        />
        <.button class="mb-2 min-h-11 gap-2 md:min-w-40">
          <.icon name="hero-magnifying-glass" class="size-4" /> Inspect source
        </.button>
      </.form>

      <div :if={@local_store_error} id="local-store-error" class="alert alert-error items-start">
        <.icon name="hero-exclamation-triangle" class="mt-0.5 size-5 shrink-0" />
        <div class="min-w-0">
          <p class="font-semibold">Immutable source could not be staged</p>
          <p class="break-words text-sm">{@local_store_error}</p>
        </div>
      </div>

      <div
        :if={source = @local_store_candidate}
        id="local-store-candidate"
        class="overflow-hidden rounded-box border border-success/35 bg-base-100 shadow-sm"
      >
        <header class="flex flex-col gap-3 border-b border-base-300 bg-success/5 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="text-xl font-bold">{source.project}</h3>
              <span class="badge badge-success badge-outline badge-sm">Nix verified</span>
            </div>
            <p class="mt-1 break-all font-mono text-xs text-base-content/50">
              {source.store_path}
            </p>
          </div>
          <span class="shrink-0 font-mono text-xs text-base-content/55">
            {map_size(source.targets)} target{if map_size(source.targets) == 1, do: "", else: "s"}
          </span>
        </header>

        <div class="grid min-w-0 gap-6 p-5 lg:grid-cols-[minmax(0,0.75fr)_minmax(0,1.25fr)]">
          <div class="min-w-0 space-y-4">
            <div>
              <p class="text-xs uppercase text-base-content/50">NAR hash</p>
              <p class="mt-1 break-all font-mono text-xs leading-relaxed">{source.nar_hash}</p>
            </div>

            <.form
              for={@local_store_stage_form}
              id="local-store-stage-form"
              phx-change="select_local_store_target"
              phx-submit="stage_local_store"
              class="space-y-3"
            >
              <.input
                field={@local_store_stage_form[:selected_target]}
                type="select"
                label="Target derived from flake"
                prompt="Select target"
                options={local_store_target_options(source)}
                required
              />
              <.button class="min-h-11 w-full" disabled={is_nil(@local_store_selected_target)}>
                Stage verified input
              </.button>
            </.form>
          </div>

          <% target = selected_local_store_target(source, @local_store_selected_target) %>
          <div
            :if={target}
            id="local-store-target-preview"
            class="grid min-w-0 gap-px overflow-hidden rounded-box bg-base-300 sm:grid-cols-2"
          >
            <div class="min-w-0 bg-base-200/70 p-4 sm:col-span-2">
              <p class="text-xs uppercase text-base-content/50">Image output</p>
              <p class="mt-1 break-all font-mono text-sm">{target["image_output"]}</p>
            </div>
            <div class="min-w-0 bg-base-200/70 p-4">
              <p class="text-xs uppercase text-base-content/50">Blue slot</p>
              <p class="mt-1 font-mono text-lg font-bold tabular-nums">
                {target["slots"]["blue"]}
              </p>
            </div>
            <div class="min-w-0 bg-base-200/70 p-4">
              <p class="text-xs uppercase text-base-content/50">Green slot</p>
              <p class="mt-1 font-mono text-lg font-bold tabular-nums">
                {target["slots"]["green"]}
              </p>
            </div>
            <div class="min-w-0 bg-base-200/70 p-4 sm:col-span-2">
              <p class="text-xs uppercase text-base-content/50">Domain</p>
              <p class="mt-1 break-all font-mono text-sm">{target["domain"]}</p>
            </div>
            <div class="min-w-0 bg-base-200/70 p-4 sm:col-span-2">
              <p class="text-xs uppercase text-base-content/50">Health path</p>
              <p class="mt-1 break-all font-mono text-sm">{target["health_path"]}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="deployment-input-history" class="space-y-4">
      <div>
        <h2 class="text-2xl font-bold">Immutable input history</h2>
        <p class="text-sm text-base-content/60">
          Verified source identity, derived intent, actor, and staging failures.
        </p>
      </div>

      <div :if={@deployment_inputs == []} id="empty-deployment-inputs" class="alert">
        <.icon name="hero-information-circle" class="size-5" />
        <span>No immutable deployment inputs have been staged.</span>
      </div>

      <div class="grid gap-3">
        <article
          :for={input <- @deployment_inputs}
          id={"deployment-input-#{input.id}"}
          class="min-w-0 overflow-hidden rounded-box border border-base-300 bg-base-100 shadow-sm"
        >
          <div class="grid min-w-0 gap-4 p-5 md:grid-cols-[minmax(0,1fr)_auto] md:items-center">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="break-words text-lg font-bold">
                  {input.derived_snapshot["project"] || input.selected_target || "Failed input"}
                </h3>
                <span class={["badge badge-sm", input_state_class(input.state)]}>
                  {input.state}
                </span>
                <span :if={input.selected_target} class="badge badge-ghost badge-sm">
                  {input.selected_target}
                </span>
              </div>
              <p class="mt-2 break-all font-mono text-xs text-base-content/55">
                {input.store_path}
              </p>
              <p
                :if={input.nar_hash}
                class="mt-1 break-all font-mono text-xs text-base-content/45"
              >
                {input.nar_hash}
              </p>
              <p :if={input.failure} class="mt-2 break-words text-sm text-error">
                {input.failure["message"]}
              </p>
              <p class="mt-2 text-xs text-base-content/50">
                {if input.requested_by_operator,
                  do: input.requested_by_operator.email,
                  else: "unknown actor"} · {format_time(input.inserted_at)}
              </p>
            </div>
            <.link
              navigate={~p"/deployment-inputs/#{input.id}"}
              class="btn btn-outline btn-sm min-h-11 w-full md:w-auto"
            >
              View evidence
            </.link>
          </div>
        </article>
      </div>
    </section>

    <%!-- TODO(tracer): Delete the legacy registration UI after one native local
    deployment derives project configuration directly from a flake. Keep it non-rendered
    until retained deployment records no longer depend on this reversible compatibility path. --%>
    <section :if={false} class="grid gap-6 xl:grid-cols-3">
      <div class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body">
          <h2 class="card-title">1. Add repository</h2>
          <.form
            for={@repository_form}
            id="repository-form"
            phx-submit="save_repository"
            class="space-y-3"
          >
            <.input field={@repository_form[:name]} label="Name" placeholder="my-app" required />
            <.input
              field={@repository_form[:url]}
              type="url"
              label="Git URL"
              placeholder="https://github.com/example/my-app.git"
              required
            />
            <.input field={@repository_form[:default_ref]} label="Default ref" required />
            <.input
              field={@repository_form[:subdirectory]}
              label="Flake subdirectory"
              placeholder="."
              required
            />
            <.button class="w-full">Add repository</.button>
          </.form>
        </div>
      </div>

      <div class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body">
          <h2 class="card-title">2. Add target</h2>
          <.form for={@target_form} id="target-form" phx-submit="save_target" class="space-y-3">
            <.input field={@target_form[:name]} label="Name" placeholder="production" required />
            <.input
              field={@target_form[:host]}
              label="Host"
              placeholder="vps.example.com"
              required
            />
            <div class="grid grid-cols-2 gap-3">
              <.input field={@target_form[:ssh_user]} label="SSH user" required />
              <.input field={@target_form[:ssh_port]} type="number" label="SSH port" required />
            </div>
            <.button class="w-full">Add target</.button>
          </.form>
        </div>
      </div>

      <div class="card border border-base-300 bg-base-100 shadow-sm">
        <div class="card-body">
          <h2 class="card-title">3. Attach service</h2>
          <.form for={@service_form} id="service-form" phx-submit="save_service" class="space-y-3">
            <.input field={@service_form[:name]} label="Name" placeholder="web" required />
            <.input
              field={@service_form[:repository_id]}
              type="select"
              label="Repository"
              prompt="Select repository"
              options={@repository_options}
              required
            />
            <.input
              field={@service_form[:target_id]}
              type="select"
              label="Target"
              prompt="Select target"
              options={@target_options}
              required
            />
            <.input field={@service_form[:flake_output]} label="Flake output" required />
            <.input field={@service_form[:domain]} label="Domain" placeholder="app.example.com" />
            <.input field={@service_form[:health_path]} label="Health path" required />
            <.button class="w-full" disabled={@repositories == [] or @targets == []}>
              Attach service
            </.button>
          </.form>
        </div>
      </div>
    </section>

    <section
      :if={@repositories != [] or @targets != [] or @services != []}
      id="configuration-inventory"
      class="space-y-4"
    >
      <div>
        <h2 class="text-2xl font-bold">Configuration inventory</h2>
        <p class="text-sm text-base-content/60">
          Correct registrations here. Existing deployments retain their immutable snapshots.
        </p>
      </div>

      <div class="grid gap-4 xl:grid-cols-3">
        <details class="collapse-arrow collapse border border-base-300 bg-base-100">
          <summary class="collapse-title font-semibold">
            Repositories ({length(@repositories)})
          </summary>
          <div class="collapse-content space-y-4">
            <.form
              :for={repository <- @repositories}
              for={edit_repository_form(repository)}
              id={"edit-repository-#{repository.id}"}
              phx-submit="update_repository"
              class="space-y-2 border-t border-base-300 pt-4 first:border-0 first:pt-0"
            >
              <input type="hidden" name="_id" value={repository.id} />
              <.input
                id={"edit-repository-#{repository.id}-name"}
                field={edit_repository_form(repository)[:name]}
                label="Name"
                required
              />
              <.input
                id={"edit-repository-#{repository.id}-url"}
                field={edit_repository_form(repository)[:url]}
                label="Git URL"
                required
              />
              <div class="grid grid-cols-2 gap-2">
                <.input
                  id={"edit-repository-#{repository.id}-default-ref"}
                  field={edit_repository_form(repository)[:default_ref]}
                  label="Default ref"
                  required
                />
                <.input
                  id={"edit-repository-#{repository.id}-subdirectory"}
                  field={edit_repository_form(repository)[:subdirectory]}
                  label="Subdirectory"
                  required
                />
              </div>
              <.button class="btn-sm w-full">Save repository</.button>
            </.form>
          </div>
        </details>

        <details class="collapse-arrow collapse border border-base-300 bg-base-100">
          <summary class="collapse-title font-semibold">Targets ({length(@targets)})</summary>
          <div class="collapse-content space-y-4">
            <.form
              :for={target <- @targets}
              for={edit_target_form(target)}
              id={"edit-target-#{target.id}"}
              phx-submit="update_target"
              class="space-y-2 border-t border-base-300 pt-4 first:border-0 first:pt-0"
            >
              <input type="hidden" name="_id" value={target.id} />
              <.input
                id={"edit-target-#{target.id}-name"}
                field={edit_target_form(target)[:name]}
                label="Name"
                required
              />
              <.input
                id={"edit-target-#{target.id}-host"}
                field={edit_target_form(target)[:host]}
                label="Host"
                required
              />
              <div class="grid grid-cols-2 gap-2">
                <.input
                  id={"edit-target-#{target.id}-ssh-user"}
                  field={edit_target_form(target)[:ssh_user]}
                  label="SSH user"
                  required
                />
                <.input
                  id={"edit-target-#{target.id}-ssh-port"}
                  field={edit_target_form(target)[:ssh_port]}
                  type="number"
                  label="Port"
                  required
                />
              </div>
              <.button class="btn-sm w-full">Save target</.button>
            </.form>
          </div>
        </details>

        <details class="collapse-arrow collapse border border-base-300 bg-base-100">
          <summary class="collapse-title font-semibold">Services ({length(@services)})</summary>
          <div class="collapse-content space-y-4">
            <.form
              :for={service <- @services}
              for={edit_service_form(service)}
              id={"edit-service-#{service.id}"}
              phx-submit="update_service"
              class="space-y-2 border-t border-base-300 pt-4 first:border-0 first:pt-0"
            >
              <input type="hidden" name="_id" value={service.id} />
              <.input
                id={"edit-service-#{service.id}-name"}
                field={edit_service_form(service)[:name]}
                label="Name"
                required
              />
              <.input
                id={"edit-service-#{service.id}-repository"}
                field={edit_service_form(service)[:repository_id]}
                type="select"
                label="Repository"
                options={@repository_options}
                required
              />
              <.input
                id={"edit-service-#{service.id}-target"}
                field={edit_service_form(service)[:target_id]}
                type="select"
                label="Target"
                options={@target_options}
                required
              />
              <.input
                id={"edit-service-#{service.id}-flake-output"}
                field={edit_service_form(service)[:flake_output]}
                label="Flake output"
                required
              />
              <.input
                id={"edit-service-#{service.id}-domain"}
                field={edit_service_form(service)[:domain]}
                label="Domain"
              />
              <.input
                id={"edit-service-#{service.id}-health-path"}
                field={edit_service_form(service)[:health_path]}
                label="Health path"
                required
              />
              <.button class="btn-sm w-full">Save service</.button>
            </.form>
          </div>
        </details>
      </div>
    </section>

    <section
      :if={@services != []}
      class="card border border-base-300 bg-base-100 shadow-sm"
    >
      <div class="card-body gap-6">
        <div>
          <h2 class="card-title">Queue deployment</h2>
          <p class="text-sm text-base-content/60">
            The worker pins the commit, validates the flake target, serializes the target mutation, and independently verifies the result.
          </p>
        </div>

        <.form
          for={@deployment_form}
          id="deployment-form"
          phx-submit="enqueue_deployment"
          phx-change="select_deployment_service"
          class="grid items-end gap-4 md:grid-cols-[2fr_1fr_auto]"
        >
          <.input
            field={@deployment_form[:service_id]}
            type="select"
            label="Service"
            prompt="Select service"
            options={@service_options}
            required
          />
          <.input field={@deployment_form[:requested_ref]} label="Git ref" required />
          <.button
            class="mb-2"
            disabled={@services == []}
            data-confirm="Deploy this immutable revision to the selected target?"
          >
            Deploy
          </.button>
        </.form>
      </div>
    </section>

    <section :if={@services != []} id="service-statuses" class="space-y-4">
      <div>
        <h2 class="text-2xl font-bold">Observed service status</h2>
        <p class="text-sm text-base-content/60">
          Status is read by a credentialed worker and persisted for the web role.
        </p>
      </div>

      <article
        :for={service <- @services}
        id={"service-status-#{service.id}"}
        class="card border border-base-300 bg-base-100 shadow-sm"
      >
        <% observation = @observations_by_service[service.id] %>
        <% log_snapshot = @log_snapshots_by_service[service.id] %>
        <div class="card-body gap-5">
          <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-start">
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="card-title">{service.name}</h3>
                <span :if={observation} class={["badge", observation_class(observation.status)]}>
                  {observation.status}
                </span>
                <span :if={is_nil(observation)} class="badge badge-ghost">not observed</span>
              </div>
              <p class="text-sm text-base-content/60">
                {service.target.name}
                <span :if={service.domain}>{" · " <> service.domain}</span>
              </p>
            </div>
            <div class="flex flex-wrap gap-2">
              <.button
                id={"refresh-status-#{service.id}"}
                phx-click="refresh_service_status"
                phx-value-id={service.id}
                class="btn-sm"
                disabled={observation && observation.status == :pending}
              >
                Refresh status
              </.button>
              <.button
                id={"fetch-logs-#{service.id}"}
                phx-click="fetch_service_logs"
                phx-value-id={service.id}
                class="btn-outline btn-sm"
                disabled={log_snapshot && log_snapshot.status == :pending}
              >
                Fetch logs
              </.button>
            </div>
          </div>

          <div :if={is_nil(observation)} class="alert">
            <span>No worker observation has been requested.</span>
          </div>

          <div :if={observation && observation.failure} class="alert alert-error text-sm">
            <.icon name="hero-exclamation-circle" class="size-5" />
            <span>{observation.failure["message"] || observation.failure[:message]}</span>
          </div>

          <div :if={observation} class="grid gap-4 text-sm md:grid-cols-2 xl:grid-cols-4">
            <div>
              <span class="block text-xs uppercase text-base-content/50">Slots</span>
              <span class="font-medium">
                {observation.active_slot || "-"} active · {observation.inactive_slot || "-"} inactive
              </span>
            </div>
            <div>
              <span class="block text-xs uppercase text-base-content/50">Active container</span>
              <span class="font-mono text-xs">{observation.active_container || "-"}</span>
              <span class="block text-base-content/60">
                {observation.active_container_state || "-"}
              </span>
            </div>
            <div>
              <span class="block text-xs uppercase text-base-content/50">Inactive container</span>
              <span class="font-mono text-xs">{observation.inactive_container || "-"}</span>
              <span class="block text-base-content/60">
                {observation.inactive_container_state || "-"}
              </span>
            </div>
            <div>
              <span class="block text-xs uppercase text-base-content/50">Image</span>
              <span class="font-mono text-xs">{observation.image || "-"}</span>
            </div>
            <div>
              <span class="block text-xs uppercase text-base-content/50">Revision</span>
              <span class="font-mono">{short_commit(observation.git_commit)}</span>
              <span class="block text-base-content/60">
                {format_time(observation.deployed_at)}
              </span>
            </div>
            <div>
              <span class="block text-xs uppercase text-base-content/50">Caddy</span>
              <span class="font-mono text-xs">{observation.upstream || "-"}</span>
              <span class="block truncate text-base-content/60">
                {observation.caddy_route || "-"}
              </span>
            </div>
            <div>
              <span class="block text-xs uppercase text-base-content/50">Health</span>
              <span class={["badge", health_class(observation.health_status)]}>
                {observation.health_status || observation.health_error || "pending"}
              </span>
              <span class="block truncate text-base-content/60">
                {observation.health_url || "-"}
              </span>
            </div>
            <div>
              <span class="block text-xs uppercase text-base-content/50">Observed</span>
              <span>{format_time(observation.refreshed_at)}</span>
              <span class="block font-mono text-xs text-base-content/60">
                {observation.target_identity || "-"}
              </span>
            </div>
          </div>

          <section class="space-y-3 border-t border-base-300 pt-4">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div>
                <h4 class="font-semibold">Active container logs</h4>
                <p class="text-xs text-base-content/50">Latest bounded 200-entry snapshot.</p>
              </div>
              <span
                :if={log_snapshot}
                class={["badge", log_snapshot_class(log_snapshot.status)]}
              >
                {log_snapshot.status}
              </span>
            </div>

            <div :if={is_nil(log_snapshot)} class="rounded-box bg-base-200 p-4 text-sm">
              No log snapshot has been requested.
            </div>

            <div :if={log_snapshot && log_snapshot.failure} class="alert alert-error text-sm">
              <.icon name="hero-exclamation-circle" class="size-5" />
              <span>{log_snapshot.failure["message"] || log_snapshot.failure[:message]}</span>
            </div>

            <div :if={log_snapshot && log_snapshot.content} class="space-y-2">
              <div class="flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-base-content/60">
                <span>{log_snapshot.slot || "-"} · {log_snapshot.container_name || "-"}</span>
                <span>{log_snapshot.line_count || 0} lines</span>
                <span :if={log_snapshot.truncated} class="text-warning">output truncated</span>
                <span>{format_time(log_snapshot.fetched_at)}</span>
              </div>
              <pre
                id={"service-logs-#{service.id}"}
                class="max-h-96 overflow-auto rounded-box bg-neutral p-4 font-mono text-xs leading-relaxed text-neutral-content shadow-inner"
              ><code>{log_snapshot.content}</code></pre>
            </div>
          </section>
        </div>
      </article>
    </section>

    <section class="space-y-4">
      <div>
        <h2 class="text-2xl font-bold">Deployment history</h2>
        <p class="text-sm text-base-content/60">Newest deployments appear first.</p>
      </div>

      <div :if={@deployments == []} id="empty-deployments" class="alert">
        <.icon name="hero-information-circle" class="size-5" />
        <span>No deployments have been queued.</span>
      </div>

      <article
        :for={deployment <- @deployments}
        id={"deployment-#{deployment.id}"}
        class="card border border-base-300 bg-base-100 shadow-sm"
      >
        <div class="card-body gap-5">
          <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-start">
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="card-title">{deployment.service.name}</h3>
                <span class={["badge", state_class(deployment.state)]}>{deployment.state}</span>
                <span
                  :if={deployment.cancellation_requested_at}
                  class="badge badge-warning badge-outline"
                >
                  cancelling
                </span>
              </div>
              <p class="text-sm text-base-content/60">
                {deployment.service.repository.name}@{deployment.requested_ref} → {deployment.service.target.name}
                <span :if={deployment.service.domain}>{" · #{deployment.service.domain}"}</span>
              </p>
              <p class="mt-1 font-mono text-xs text-base-content/50">{deployment.id}</p>
              <p class="text-xs text-base-content/50">
                Requested by {if deployment.requested_by_operator,
                  do: deployment.requested_by_operator.email,
                  else: "system"}
              </p>
            </div>

            <div class="flex flex-wrap gap-2">
              <.button
                :if={terminal?(deployment) and deployment.resolved_commit}
                id={"retry-#{deployment.id}"}
                phx-click="retry_deployment"
                phx-value-id={deployment.id}
                data-confirm="Queue this exact commit and immutable configuration again?"
                class="btn-outline btn-sm"
              >
                Redeploy revision
              </.button>
              <.button
                :if={not terminal?(deployment) and is_nil(deployment.cancellation_requested_at)}
                id={"cancel-#{deployment.id}"}
                phx-click="cancel_deployment"
                phx-value-id={deployment.id}
                data-confirm="Cancel this deployment?"
                class="btn-warning btn-sm"
              >
                Cancel
              </.button>
            </div>
          </div>

          <div class="grid gap-3 text-sm sm:grid-cols-4">
            <div>
              <span class="block text-xs uppercase text-base-content/50">Current stage</span>
              <span class="font-medium">{deployment.current_stage}</span>
            </div>
            <div>
              <span class="block text-xs uppercase text-base-content/50">Revision</span>
              <span class="font-mono">{short_commit(deployment.resolved_commit)}</span>
            </div>
            <div>
              <span class="block text-xs uppercase text-base-content/50">Started</span>
              <span>{format_time(deployment.started_at)}</span>
            </div>
            <div>
              <span class="block text-xs uppercase text-base-content/50">Finished</span>
              <span>{format_time(deployment.finished_at)}</span>
            </div>
          </div>

          <div :if={deployment.output} class="space-y-2">
            <div class="flex flex-wrap gap-3 font-mono text-xs text-base-content/55">
              <span>{deployment.output.line_count} output lines retained as a bounded tail</span>
              <span :if={deployment.output.truncated} class="text-warning">
                earlier output truncated
              </span>
            </div>
            <pre
              id={"deployment-output-#{deployment.id}"}
              class="max-h-72 overflow-auto rounded-box bg-neutral p-4 font-mono text-xs leading-relaxed text-neutral-content shadow-inner"
            ><code>{deployment.output.content}</code></pre>
          </div>

          <div :if={deployment.failure} class="alert alert-error text-sm">
            <.icon name="hero-exclamation-circle" class="size-5" />
            <span>{deployment.failure["message"] || deployment.failure[:message]}</span>
          </div>

          <ol class="space-y-2 border-l border-base-300 pl-4">
            <li :for={event <- @events_by_deployment[deployment.id]} id={"event-#{event.id}"}>
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <span class="font-medium">{event.message}</span>
                <time class="font-mono text-xs text-base-content/50">
                  {format_time(event.inserted_at)}
                </time>
              </div>
              <span class="text-xs uppercase tracking-wide text-base-content/50">
                {event.stage}
              </span>
            </li>
          </ol>
        </div>
      </article>
    </section>

    <section id="audit-history" class="space-y-4">
      <div>
        <h2 class="text-2xl font-bold">Operator audit history</h2>
        <p class="text-sm text-base-content/60">Latest append-only control-plane actions.</p>
      </div>
      <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100">
        <table class="table table-sm">
          <thead>
            <tr>
              <th>Time</th>
              <th>Actor</th>
              <th>Action</th>
              <th>Resource</th>
              <th>Outcome</th>
            </tr>
          </thead>
          <tbody>
            <tr :for={event <- @audit_events} id={"audit-event-#{event.id}"}>
              <td class="whitespace-nowrap font-mono text-xs">
                {format_time(event.occurred_at)}
              </td>
              <td>{if event.operator, do: event.operator.email, else: "system"}</td>
              <td class="font-medium">{event.action}</td>
              <td class="font-mono text-xs">{event.resource_type}:{event.resource_id}</td>
              <td><span class="badge badge-ghost badge-sm">{event.outcome}</span></td>
            </tr>
            <tr :if={@audit_events == []}>
              <td colspan="5" class="text-center text-base-content/50">
                No audited actions yet.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Layouts.app>
